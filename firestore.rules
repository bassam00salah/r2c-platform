rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ────────────────────────────────────────────────────────────

    function isSignedIn() {
      return request.auth != null;
    }

    function isUser(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isAdmin() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function isRestaurantOwner() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/restaurantOwners/$(request.auth.uid));
    }

    function isBranchPartner() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/branches/$(request.auth.uid));
    }

    function isOptionalString(value, maxLen) {
      return !(value is string) || value.size() <= maxLen;
    }

    function userCreateSchemaIsValid() {
      return request.resource.data.keys().hasOnly([
        'name', 'email', 'photoURL', 'createdAt', 'phone', 'address'
      ])
      && (!('name'     in request.resource.data) || isOptionalString(request.resource.data.name,     100))
      && (!('email'    in request.resource.data) || isOptionalString(request.resource.data.email,    320))
      && (!('photoURL' in request.resource.data) || isOptionalString(request.resource.data.photoURL, 1000))
      && (!('phone'    in request.resource.data) || isOptionalString(request.resource.data.phone,    20))
      && (!('address'  in request.resource.data) || isOptionalString(request.resource.data.address,  300))
      && ('createdAt' in request.resource.data);
    }

    // ✅ الإصلاح: نفحص الحقول التي تغيّرت فقط (affectedKeys)
    // بدل فحص كل حقول الـ document — هذا يسمح بوجود حقول إضافية
    // أضافتها Cloud Functions (مثل fcmToken) دون أن تُعيق التحديث
    function userUpdateSchemaIsValid() {
      let affected = request.resource.data.diff(resource.data).affectedKeys();
      return affected.hasOnly(['name', 'email', 'photoURL', 'phone', 'address'])
        && request.resource.data.createdAt == resource.data.createdAt
        && (!('name'     in request.resource.data) || isOptionalString(request.resource.data.name,     100))
        && (!('email'    in request.resource.data) || isOptionalString(request.resource.data.email,    320))
        && (!('photoURL' in request.resource.data) || isOptionalString(request.resource.data.photoURL, 1000))
        && (!('phone'    in request.resource.data) || isOptionalString(request.resource.data.phone,    20))
        && (!('address'  in request.resource.data) || isOptionalString(request.resource.data.address,  300));
    }

    // ── Collections ────────────────────────────────────────────────────────

    match /users/{uid} {
      allow read: if isUser(uid);
      allow create: if isUser(uid) && userCreateSchemaIsValid();
      allow update: if isUser(uid) && userUpdateSchemaIsValid();
      allow delete: if false;
    }

    match /orders/{orderId} {
      allow list: if isSignedIn() && (
        isAdmin() ||
        isRestaurantOwner() ||
        isBranchPartner() ||
        request.auth.uid != null
      );

      allow get: if isSignedIn() && (
        resource.data.userId == request.auth.uid ||
        resource.data.branchId == request.auth.uid ||
        isAdmin() ||
        (
          isRestaurantOwner() &&
          resource.data.restaurantId ==
            get(/databases/$(database)/documents/restaurantOwners/$(request.auth.uid)).data.restaurantId
        )
      );

      allow create: if false;

      // المستخدم يمكنه إلغاء طلبه فقط إذا كان pending أو accepted
      allow update: if isSignedIn()
        && resource.data.userId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['status', 'cancelReason', 'cancelledAt', 'updatedAt'])
        && request.resource.data.status == 'cancelled'
        && resource.data.status in ['pending', 'accepted'];

      allow delete: if false;
    }

    match /branches/{branchId} {
      allow read: if isSignedIn();
      allow create: if isAdmin();
      allow update: if isAdmin() || (isBranchPartner() && request.auth.uid == branchId);
      allow delete: if isAdmin();
    }

    match /restaurantOwners/{ownerId} {
      allow read: if isSignedIn() && (
        request.auth.uid == ownerId ||
        isAdmin()
      );
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    match /admins/{adminId} {
      allow read: if isSignedIn() && (
        request.auth.uid == adminId ||
        isAdmin()
      );
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    match /offers/{offerId} {
      allow read: if isSignedIn();
      allow create: if isAdmin() || isRestaurantOwner();
      allow update: if isAdmin() || isRestaurantOwner();
      allow delete: if isAdmin() || isRestaurantOwner();
    }

    match /restaurants/{restaurantId} {
      allow read: if isSignedIn();
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /system/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /influencers/{docId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    match /_rateLimits/{docId} {
      allow read: if false;
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
